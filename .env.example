# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# PHASE 7 — PRODUCTION INTEGRATIONS CONFIGURATION
# Notice: All integrations safely default to local/mock mode until credentials
# are configured. No paid charges will occur without valid credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SMS / OTP PROVIDERS (Pakistan Delivery Focus)
# Active provider selector: 'mock' (default) | 'infobip' | 'twilio' | 'jazz'
# Recommendation: INFOBIP for direct SS7 telco routes and branded "POSTEX" mask.
# ------------------------------------------------------------------------------
SMS_PROVIDER="mock"

# OPTION A: Infobip (RECOMMENDED FOR PAKISTAN)
# Account: Infobip Enterprise Account (portal.infobip.com)
# Credentials: API Key from Developer Tools and custom Base URL
INFOBIP_API_KEY=""
INFOBIP_BASE_URL=""
INFOBIP_SENDER_ID="POSTEX"

# OPTION B: Twilio Programmable SMS
# Account: Twilio Console (twilio.com/console)
# Credentials: Account SID, Auth Token, and Approved Sender Number / Messaging Service SID
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""

# OPTION C: Jazz Business SMS / Local Pakistan Corporate Aggregator
# Account: Mobilink / Jazz Corporate Services portal
# Credentials: API Endpoint URL, Portal Username, Password, and PTA-approved Mask
JAZZ_SMS_API_URL=""
JAZZ_SMS_USERNAME=""
JAZZ_SMS_PASSWORD=""
JAZZ_SMS_MASK="PostEx"

# ------------------------------------------------------------------------------
# 2. TRANSACTIONAL EMAIL PROVIDERS
# Active provider selector: 'mock' (default) | 'ses' | 'sendgrid' | 'mailgun'
# Recommendation: AWS SES for lowest cost ($0.10/1k), 99.9% SLA, and custom domain DKIM.
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="mock"
EMAIL_FROM_ADDRESS="onboarding@postex.pk"

# OPTION A: AWS SES (RECOMMENDED BEST OPTION)
# Account: Amazon Web Services (AWS IAM User with AmazonSESFullAccess policy)
# Credentials: AWS Access Key ID, Secret Access Key, and verified Region
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"

# OPTION B: SendGrid
# Account: SendGrid Console (app.sendgrid.com)
# Credentials: API Key starting with 'SG.'
SENDGRID_API_KEY=""

# OPTION C: Mailgun by Sinch
# Account: Mailgun Control Panel (app.mailgun.com)
# Credentials: Mailgun Private API Key, Sending Domain, and optional Region ('us' or 'eu')
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_REGION="us"

# ------------------------------------------------------------------------------
# 3. PRIVATE DOCUMENT STORAGE (Supabase Storage)
# Storage provider selector: 'local_vault' (default safe dev) | 'supabase'
# Buckets are strictly private. All document and signature downloads use 15-min signed URLs.
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="local_vault"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="hr-private-documents"
STORAGE_SIGNED_URL_EXPIRY_SECONDS="900"

# ------------------------------------------------------------------------------
# 4. WHATSAPP BUSINESS CLOUD API (Meta)
# Active provider selector: 'mock' (default) | 'meta_cloud'
# Account: Meta for Developers (developers.facebook.com) + Meta Business Manager
# Credentials: Permanent System User Access Token, Phone Number ID, and WABA ID
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER="mock"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v19.0"
